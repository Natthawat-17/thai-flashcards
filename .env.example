# Copy this file to .env and fill in your own values. The real .env is private and never goes to GitHub.
# Online (Vercel) you set the same names in the project's Environment Variables instead of using a file.

# Database. Leave it out to use a local SQLite file; set it to your Postgres address (for example from Neon) online.
DATABASE_URL=

# Sign in with Google: the Client ID from Google Cloud (a public value, not a secret).
GOOGLE_CLIENT_ID=
# The Google account that should receive the words saved before accounts existed (optional).
LEGACY_OWNER_EMAIL=

# Sentence translation (DeepL). Without it, word meanings still work.
DEEPL_API_KEY=
# The most characters sent to DeepL per day for everyone together (default 15000).
# DEEPL_GLOBAL_DAILY_CHARS=15000

# Signs the cookie that remembers visitors. REQUIRED online: use a long random value, for example from
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Online only (behind https and behind Vercel's proxy):
# COOKIE_SECURE=1
# TRUST_PROXY=1
